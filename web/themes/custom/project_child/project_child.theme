<?php

/**
 * @file
 * Theme hooks for the Project Child theme.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function project_child_preprocess_html(array &$variables): void {
  $variables['attributes']['class'][] = 'project-child';
}

/**
 * Implements hook_form_system_theme_settings_alter().
 */
function project_child_form_system_theme_settings_alter(array &$form, FormStateInterface $form_state): void {
  // Add custom theme settings here.
}
