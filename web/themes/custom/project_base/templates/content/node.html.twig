{#
/**
 * @file
 * Node: text of a document in the old "#document" box. node--news and
 * node--page extend this template.
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}
{{ attach_library('project_base/node') }}
<article{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label and view_mode != "full" %}
    <h2{{ title_attributes }}><a href="{{ url }}" rel="bookmark">{{ label }}</a></h2>
  {% endif %}
  {{ title_suffix }}

  {% if view_mode == 'full' %}
    <div id="document">
      {% block meta %}{% endblock %}
      <div{{ content_attributes.addClass('node__content') }}>
        {{ content }}
      </div>
    </div>
  {% else %}
    <div{{ content_attributes.addClass('node__content') }}>
      {{ content }}
    </div>
  {% endif %}
</article>
