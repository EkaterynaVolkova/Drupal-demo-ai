{#
/**
 * @file
 * Page layout of the migrated shapovalov.md site: logo and contacts band,
 * top image, left column (menu, news, banner), content, footer.
 */
#}
<div id="all">
  <div id="t">&nbsp;</div>
  <div id="wrapper">
    <div id="header">
      {{ page.page_top }}
      <div id="lp">
        <div class="a">
          <a href="{{ front_page }}" rel="home" title="{{ site_name }}">
            <img src="/{{ directory }}/images/site/logo.jpg" width="600" height="68" alt="{{ site_name }}{% if site_slogan %} - {{ site_slogan }}{% endif %}">
          </a>
          {{ page.header }}
        </div>
        <div class="b">{{ page.header_right }}</div>
      </div>
      <div id="topimage">&nbsp;</div>
    </div>

    <div id="container">
      <div id="side-a">
        <div id="sidea">
          <h3 class="ch">&nbsp;</h3>
          {{ page.sidebar_first }}
        </div>
      </div>
      <div id="side-b">
        <div id="sideb">
          {{ page.content_top }}
          {% if site_navigation %}
            <div id="sitenavigation">{{ site_navigation }}</div>
          {% endif %}
          {{ page.highlighted }}
          {{ page.help }}
          <a id="main-content" tabindex="-1"></a>
          {{ page.content }}
        </div>
      </div>
    </div>

    <div id="footer">
      <p class="copyright">Copyright &copy; {{ site_name }} 2008&ndash;{{ 'now'|date('Y') }}</p>
      <div id="botmenu">{{ page.footer }}</div>
    </div>
  </div>
  <div id="f">&nbsp;</div>
  {{ page.page_bottom }}
</div>
