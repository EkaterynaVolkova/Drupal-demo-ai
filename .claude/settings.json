{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(vendor/bin/drush status*)",
      "Bash(vendor/bin/drush cr)",
      "Bash(vendor/bin/drush cex*)",
      "Bash(vendor/bin/drush config:status*)",
      "Bash(vendor/bin/drush migrate:status*)",
      "Bash(vendor/bin/phpcs *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./web/sites/*/settings.php)",
      "Read(./web/sites/*/settings.local.php)",
      "Read(./.env)",
      "Edit(./web/core/**)",
      "Edit(./web/modules/contrib/**)",
      "Edit(./web/themes/contrib/**)",
      "Bash(vendor/bin/drush migrate:rollback*)",
      "Bash(vendor/bin/drush sql:drop*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
